{
  "name": "mofu-voice-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:css && pnpm run \"/^dev:/\"",
    "test:web": "node --experimental-test-module-mocks --test \"frontend/src/**/*.test.mjs\"",
    "build": "vite build --config frontend/vite.config.ts",
    "desktop:dev": "tauri dev --features desktop",
    "desktop:build": "tauri build --features desktop -- --locked",
    "dev:vite": "vite --config frontend/vite.config.ts",
    "dev:css": "pnpm generate:css --watch",
    "generate:css": "node frontend/tooling/css-modules-kit/clean-generated.mjs && pnpm --dir frontend/tooling/css-modules-kit exec cmk -p ../../tsconfig.json",
    "check:css": "pnpm generate:css && git diff --exit-code -- ':(glob)frontend/src/**/*.module.css.d.ts'",
    "typecheck": "tsc -p frontend/tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "i18next": "26.5.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "valibot": "1.5.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=26.12.1 <27",
    "pnpm": "12.15.0"
  },
  "packageManager": "pnpm@12.15.0"
}
